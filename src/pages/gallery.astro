---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Gallery">
  <section class="page-intro">
    <p class="eyebrow">Demo · Placeholder</p>
    <h1>Gallery</h1>
    <p>A place for original, permission-approved photos in a future stage.</p>
  </section>
  <div class="card-grid">
    {[1, 2, 3].map((number) => <div class="gallery-placeholder">Photo placeholder {number} · No image yet</div>)}
  </div>
</BaseLayout>
