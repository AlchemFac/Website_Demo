# PUBLIC values are embedded at build time and visible to visitors.
# Leave BOTH blank for offline demo mode. Never add private API/secret keys here.
PUBLIC_FORMSPREE_FORM_ID=
PUBLIC_TURNSTILE_SITE_KEY=
# Put the Turnstile SECRET in the Formspree dashboard, not in this project.

# Final root HTTPS origin, e.g. your verified domain. Leave blank until chosen.
SITE_URL=
# Indexing also requires business.isDemo=false after all client content is verified.
ALLOW_INDEXING=false
