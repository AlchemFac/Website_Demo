---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  id: string;
}
const { eyebrow, title, description, id } = Astro.props;
---

<div class="section-intro">
  <p class="eyebrow">{eyebrow}</p>
  <h2 id={id}>{title}</h2>
  {description && <p class="intro-description">{description}</p>}
</div>
