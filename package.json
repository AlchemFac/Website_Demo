{
  "name": "small-business-website-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node scripts/build-test.mjs demo && playwright test",
    "test:ui": "playwright test --ui",
    "verify": "npm run format:check && npm run check && npm run test:config && npm run test:seo && npm run build && npm test && npm run test:submission && npm run test:packages",
    "test:submission": "node scripts/build-test.mjs submission && playwright test --config playwright.submission.config.ts",
    "test:seo": "node --test tests/seo.test.mjs",
    "test:packages": "node scripts/build-package-tests.mjs && playwright test --config playwright.packages.config.ts",
    "test:config": "node --test tests/branding.test.mjs tests/contact-copy.test.mjs tests/launch-validation.test.mjs",
    "validate": "node scripts/validate.mjs"
  },
  "dependencies": {
    "astro": "7.4.4"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3"
  }
}
