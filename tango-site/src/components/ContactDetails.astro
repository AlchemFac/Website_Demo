---
import ArrowIcon from '../../../src/components/ArrowIcon.astro';
import SocialIcon from './SocialIcon.astro';
import {
  instructor,
  emailHref,
  telephoneHref,
  socialHref,
} from '../config/instructor';
const { contact } = instructor;
const email = emailHref(contact.email);
const phone = telephoneHref(contact.phoneHref);
const socials = [
  {
    label: 'Instagram',
    icon: 'instagram',
    href: socialHref(contact.instagram),
  },
  { label: 'Facebook', icon: 'facebook', href: socialHref(contact.facebook) },
] as const;
---

<div class="contact-details">
  <div class="contact-method">
    <span class="contact-label">Email</span>
    {email ? (
      <a class="contact-value" href={email}>
        {contact.email}
        <ArrowIcon />
      </a>
    ) : (
      <p class="pending-value">Email to be added</p>
    )}
  </div>
  <div class="contact-method">
    <span class="contact-label">Phone</span>
    {phone && contact.phoneDisplay ? (
      <a class="contact-value" href={phone}>
        {contact.phoneDisplay}
        <ArrowIcon />
      </a>
    ) : (
      <p class="pending-value">Phone to be added</p>
    )}
  </div>
  <div class="social-row" aria-label="Social channels">
    {socials.map(({ label, icon, href }) =>
      href ? (
        <a
          class="social-icon"
          href={href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${label} (opens in a new tab)`}
          title={`${label} (opens in a new tab)`}
        >
          <SocialIcon name={icon} />
        </a>
      ) : (
        <span
          class="social-icon social-pending"
          aria-disabled="true"
          title={`${label} — link to be added`}
        >
          <SocialIcon name={icon} />
          <span class="sr-only">{label} link to be added</span>
        </span>
      ),
    )}
  </div>
</div>
