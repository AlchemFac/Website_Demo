---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Button from '../../../src/components/Button.astro';
import ArrowIcon from '../../../src/components/ArrowIcon.astro';
import LessonCard from '../components/LessonCard.astro';
import ContactDetails from '../components/ContactDetails.astro';
import Portfolio from '../components/Portfolio.astro';
import EventCalendar from '../components/EventCalendar.astro';
import ContactForm from '../../../src/components/ContactForm.astro';
import { contactForm, formContent, formMessages } from '../config/contact';
import { privacy } from '../config/privacy';
import hero from '../assets/tango-salon.png';
import {
  instructor,
  content,
  lessons,
  emailHref,
  telephoneHref,
} from '../config/instructor';
const contactReady = Boolean(
  emailHref(instructor.contact.email) ||
  telephoneHref(instructor.contact.phoneHref),
);
---

<Layout
  title={content.metadata.title}
  description={content.metadata.description}
>
  <section class="hero" aria-labelledby="hero-title">
    <Image
      class="hero-image"
      src={hero}
      alt=""
      widths={[480, 800, 1200, 1600, 2000]}
      sizes="(max-width: 760px) 1100px, 100vw"
      format="webp"
      quality={82}
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="wrap hero-content">
      <p class="eyebrow">{content.hero.eyebrow}</p>
      <h1 id="hero-title">
        {content.hero.heading}
        <br />
        <em>{content.hero.emphasis}</em>
      </h1>
      <p class="hero-description">{content.hero.description}</p>
      <div class="hero-actions">
        <Button href="/#lessons">
          {content.hero.primaryLabel}
          <ArrowIcon />
        </Button>
        <a class="hero-secondary" href="/#about">
          {content.hero.secondaryLabel}
          <span aria-hidden="true">↓</span>
        </a>
      </div>
    </div>
    <div class="hero-bottom wrap">
      <p>Connection. Music. Movement.</p>
      <span>
        AI-generated dance illustration · not Fernanda or her students
      </span>
    </div>
  </section>
  <section
    id="about"
    class="section wrap about-section"
    tabindex="-1"
    aria-labelledby="about-title"
  >
    <div class="about-image-wrap">
      <figure class="about-figure">
        <Image
          src={hero}
          alt="Illustrative tango dancers embracing in a warmly lit salon; not Fernanda or her students."
          width={620}
          height={720}
          fit="cover"
          position="right"
          widths={[320, 480, 620, 900]}
          sizes="(min-width: 900px) 42vw, 90vw"
          format="webp"
          quality={80}
          loading="lazy"
          decoding="async"
        />
        <figcaption>
          Illustrative dance image · instructor portrait to come
        </figcaption>
      </figure>
      <div class="image-label" aria-hidden="true">
        <span>The music begins.</span>
        <em>The conversation follows.</em>
      </div>
    </div>
    <div class="about-copy">
      <p class="eyebrow">{content.about.eyebrow}</p>
      <h2 id="about-title">{content.about.heading}</h2>
      <p class="intro-text">{content.about.introduction}</p>
      {content.about.paragraphs.map((text) => (
        <p>{text}</p>
      ))}
      <p class="signature">{instructor.name}</p>
      <a class="text-link" href="/#lessons">
        Explore the services
        <ArrowIcon />
      </a>
      {instructor.isPreview && (
        <p class="draft-note">{content.about.approvalNote}</p>
      )}
    </div>
  </section>
  <section
    id="lessons"
    class="lessons-section section"
    tabindex="-1"
    aria-labelledby="lessons-title"
  >
    <div class="wrap">
      <div class="section-heading-row">
        <div>
          <p class="eyebrow">{content.lessonIntro.eyebrow}</p>
          <h2 id="lessons-title">{content.lessonIntro.heading}</h2>
        </div>
        <p>{content.lessonIntro.description}</p>
      </div>
      <div class="lesson-grid">
        {lessons.map((lesson) => (
          <LessonCard lesson={lesson} />
        ))}
      </div>
      {lessons.some((lesson) => !lesson.price || !lesson.duration) && (
        <p class="lesson-note">{content.lessonIntro.note}</p>
      )}
    </div>
  </section>
  <Portfolio />
  <EventCalendar />
  <section
    class="section wrap questions-section"
    aria-labelledby="questions-title"
  >
    <div class="questions-heading">
      <p class="eyebrow">Before you begin</p>
      <h2 id="questions-title">
        A few first
        <br />
        questions.
      </h2>
      <p>
        It’s okay to be curious. Here’s a starting point for your conversation
        with Fernanda.
      </p>
    </div>
    <div class="faq-list">
      {content.faqs.map((faq) => (
        <details>
          <summary>
            {faq.question}
            <span aria-hidden="true">+</span>
          </summary>
          <p>{faq.answer}</p>
        </details>
      ))}
    </div>
  </section>
  <section
    id="contact"
    class="contact-section section"
    tabindex="-1"
    aria-labelledby="contact-title"
  >
    <div class="wrap contact-grid">
      <div class="contact-copy">
        <p class="eyebrow">{content.contact.eyebrow}</p>
        <h2 id="contact-title">{content.contact.heading}</h2>
        <p>{content.contact.description}</p>
        <p
          class="lesson-selection"
          data-selected-lesson
          hidden
          aria-live="polite"
        ></p>
        {!contactReady && (
          <p class="contact-status" role="status">
            {content.contact.pending}
          </p>
        )}
      </div>
      <div class="contact-right">
        <ContactDetails />
        <div class="location-note">
          <h3>{content.contact.locationHeading}</h3>
          <p>{content.contact.locationText}</p>
        </div>
        <a class="privacy-note" href="/privacy/">
          Read the draft privacy policy
          <ArrowIcon />
        </a>
      </div>
    </div>
    <div class="wrap inquiry-panel">
      <ContactForm
        copy={formContent}
        messages={formMessages}
        configuration={contactForm}
        serviceOptions={lessons}
        privacyConfig={privacy}
      />
    </div>
  </section>
</Layout>
<script>
  const selection = document.querySelector<HTMLElement>(
    '[data-selected-lesson]',
  );
  const contactSection = document.querySelector<HTMLElement>('#contact');
  document
    .querySelectorAll<HTMLAnchorElement>('[data-lesson]')
    .forEach((link) => {
      link.addEventListener('click', () => {
        if (!selection) return;
        selection.textContent = `You’re interested in: ${link.dataset.lesson}. Mention this when you contact Fernanda.`;
        selection.hidden = false;
        const option =
          document.querySelector<HTMLSelectElement>('#contact-service');
        const selected = Array.from(option?.options ?? []).find(
          (item) => item.textContent === link.dataset.lesson,
        );
        if (option && selected) option.value = selected.value;
        contactSection?.focus({ preventScroll: true });
      });
    });
</script>
