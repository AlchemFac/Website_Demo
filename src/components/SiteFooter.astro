---
import { siteContent } from '../config/siteContent';
import BusinessBrand from './BusinessBrand.astro';
import { business } from '../config/business';
import { navigation } from '../config/navigation';
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <BusinessBrand />
      <p>{business.branding.tagline}</p>
      {business.isDemo && <p class="footer-note">{siteContent.footerNotice}</p>}
    </div>
    <nav aria-label="Footer navigation">
      <h2 class="footer-heading">{siteContent.footer.explore}</h2>
      <ul class="footer-links">
        {navigation.map(({ label, href }) => (
          <li>
            <a href={href}>{label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <div>
      <h2 class="footer-heading">
        {business.isDemo
          ? siteContent.footer.demoInformation
          : siteContent.footer.information}
      </h2>
      <p>
        {business.isDemo ? (
          business.phone.display
        ) : (
          <a href={business.phone.href}>{business.phone.display}</a>
        )}
        <br />
        {business.isDemo ? (
          business.email
        ) : (
          <a href={`mailto:${business.email}`}>{business.email}</a>
        )}
      </p>
      <p>
        {siteContent.footer.serviceAreas} {business.serviceAreas.join(', ')}
      </p>
      <dl class="business-hours">
        {business.hours.map(({ days, hours }) => (
          <div>
            <dt>{days}</dt>
            <dd>{hours}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</footer>
