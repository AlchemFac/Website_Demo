---
import Header from '../components/Header.astro';
import { getImage } from 'astro:assets';
import logo from '../assets/fernanda-logo.png';
import Footer from '../components/Footer.astro';
import { instructor } from '../config/instructor';
import { privacy } from '../config/privacy';
import { indexingAllowed } from '../../../src/config/seo.mjs';
import '../styles/global.css';
interface Props {
  title: string;
  description: string;
  noIndex?: boolean;
}
const { title, description, noIndex = false } = Astro.props;
const icon = await getImage({
  src: logo,
  width: 64,
  height: 64,
  format: 'png',
});
const approved =
  !instructor.isPreview && instructor.contentApproved && privacy.clientApproved;
const indexable =
  !noIndex &&
  indexingAllowed(Astro.site, import.meta.env.ALLOW_INDEXING, !approved);
const canonical =
  approved && !noIndex && Astro.site
    ? new URL(Astro.url.pathname, Astro.site).href
    : undefined;
const themeStyle = Object.entries(instructor.colors)
  .map(
    ([key, value]) =>
      `--color-${key.replace(/[A-Z]/g, (c) => '-' + c.toLowerCase())}: ${value}`,
  )
  .join(';');
---

<!doctype html>
<html lang="en" style={themeStyle}>
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/png" href={icon.src} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={indexable ? 'index, follow' : 'noindex, nofollow'}
    />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="theme-color" content={instructor.colors.background} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      Skip to content
    </a>
    {instructor.isPreview && (
      <div class="preview-banner">
        Working preview · Fernanda’s copy, media and policies need approval
      </div>
    )}
    <Header />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
