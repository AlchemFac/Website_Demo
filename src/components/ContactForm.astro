---
import Button from './Button.astro';
import { contactForm } from '../config/contactForm';
import { services } from '../config/serviceContent';
---

<section class="panel" aria-labelledby="form-title">
  <h2 id="form-title">Tell us about your home</h2>
  <p id="form-notice">
    {contactForm.configured
      ? 'This is a fictional business. This form sends a test inquiry through Formspree to the site owner; it does not book a cleaning. Please use sample details. Your entries are shared with Formspree, and Cloudflare provides spam protection.'
      : 'Demo form only. This form checks your entries in your browser. It does not send or save them, request a quote, or book a cleaning. Please use sample details.'}
  </p>
  <noscript>
    <p class="notice">
      JavaScript is required to use this form. Nothing can be submitted while
      JavaScript is disabled.
    </p>
  </noscript>
  <form
    data-contact-form
    data-endpoint={contactForm.endpoint}
    data-site-key={contactForm.siteKey}
    aria-labelledby="form-title"
    aria-describedby="form-notice required-note"
  >
    <p id="required-note">
      Fields marked <span aria-hidden="true">*</span> are required. Phone is
      optional.
    </p>
    <p class="error-summary" data-error-summary role="alert" hidden></p>
    <fieldset disabled>
      <legend class="sr-only">Demo inquiry details</legend>
      <div class="form-grid">
        <div class="field">
          <label for="contact-name">
            Name <span aria-hidden="true">*</span>
          </label>
          <input
            id="contact-name"
            name="name"
            autocomplete="name"
            required
            maxlength="100"
            aria-describedby="name-error"
          />
          <p id="name-error" class="field-error" hidden></p>
        </div>
        <div class="field">
          <label for="contact-email">
            Email <span aria-hidden="true">*</span>
          </label>
          <input
            id="contact-email"
            name="email"
            type="email"
            autocomplete="email"
            required
            maxlength="254"
            aria-describedby="email-error"
          />
          <p id="email-error" class="field-error" hidden></p>
        </div>
        <div class="field">
          <label for="contact-phone">
            Phone <span class="optional">(optional)</span>
          </label>
          <input
            id="contact-phone"
            name="phone"
            type="tel"
            autocomplete="tel"
            maxlength="40"
            aria-describedby="phone-hint phone-error"
          />
          <p id="phone-hint" class="hint">
            If entered, use 7–15 digits with optional +, spaces, parentheses,
            dots, or hyphens.
          </p>
          <p id="phone-error" class="field-error" hidden></p>
        </div>
        <div class="field">
          <label for="contact-service">
            Service type <span aria-hidden="true">*</span>
          </label>
          <select
            id="contact-service"
            name="service"
            required
            aria-describedby="service-error"
          >
            <option value="">Choose a service</option>
            {services.map((service) => (
              <option value={service.id}>{service.title}</option>
            ))}
            <option value="not-sure">Not sure yet</option>
          </select>
          <p id="service-error" class="field-error" hidden></p>
        </div>
        <div class="field full-width">
          <label for="contact-message">
            Message <span aria-hidden="true">*</span>
          </label>
          <textarea
            id="contact-message"
            name="message"
            required
            maxlength="2000"
            rows="6"
            aria-describedby="message-hint message-error"
          ></textarea>
          <p id="message-hint" class="hint">
            For example: home size, priority rooms, and preferred timing.
            Maximum 2,000 characters.
          </p>
          <p id="message-error" class="field-error" hidden></p>
        </div>
      </div>
      <div hidden aria-hidden="true">
        <label for="contact-gotcha">Leave this field empty</label>
        <input
          id="contact-gotcha"
          type="text"
          name="_gotcha"
          tabindex="-1"
          autocomplete="off"
        />
      </div>
      {contactForm.configured && (
        <section class="spam-protection" aria-labelledby="spam-title">
          <h3 id="spam-title">Spam protection</h3>
          <div
            data-turnstile
            tabindex="-1"
            aria-describedby="captcha-error"
          ></div>
          <p id="captcha-error" data-captcha-error role="status" class="hint">
            Loading spam protection…
          </p>
          <Button type="button" variant="secondary" data-captcha-retry hidden>
            Retry spam protection
          </Button>
        </section>
      )}
      <Button type="submit">
        {contactForm.configured ? 'Send test inquiry' : 'Check demo form'}
      </Button>
    </fieldset>
  </form>
  <p
    class="submission-error"
    data-submission-error
    role="alert"
    tabindex="-1"
    hidden
  ></p>
  <p
    class="form-status"
    data-form-status
    role="status"
    aria-live="polite"
    aria-atomic="true"
    tabindex="-1"
  ></p>
  <Button type="button" variant="secondary" data-new-inquiry hidden>
    Start a new inquiry
  </Button>
</section>
<script>
  import '../scripts/contact-form';
</script>
<style>
  h2 {
    margin-top: 0;
  }
  #form-notice {
    color: var(--color-muted);
  }
  fieldset {
    border: 0;
    margin: 0;
    padding: 0;
    min-width: 0;
  }
  .form-grid {
    display: grid;
    gap: var(--space-5);
    margin-block: var(--space-5);
  }
  .field {
    min-width: 0;
  }
  label {
    display: block;
    font-weight: var(--weight-medium);
    margin-bottom: var(--space-2);
  }
  input,
  select,
  textarea {
    display: block;
    width: 100%;
    min-width: 0;
    min-height: 48px;
    padding: var(--space-3);
    border: 1px solid var(--color-muted);
    border-radius: var(--radius-small);
    color: var(--color-text);
    background: var(--color-surface);
  }
  textarea {
    resize: vertical;
  }
  [aria-invalid='true'] {
    border: 2px solid #9b2929;
  }
  .hint,
  .optional,
  #required-note {
    color: var(--color-muted);
    font-size: var(--text-small);
  }
  .hint,
  .field-error {
    margin-block: var(--space-2) 0;
  }
  .field-error {
    color: #9b2929;
    font-weight: var(--weight-medium);
    font-size: var(--text-small);
  }
  .error-summary,
  .submission-error,
  .notice {
    padding: var(--space-4);
    border: 1px solid #9b2929;
    border-radius: var(--radius-small);
    color: #822222;
    background: #fff5f3;
  }
  .form-status:empty {
    display: none;
  }
  .form-status {
    padding: var(--space-4);
    background: var(--color-accent);
    border-radius: var(--radius-small);
  }
  .spam-protection {
    margin-bottom: var(--space-5);
  }
  .spam-protection h3 {
    font-size: 1rem;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  @media (min-width: 40rem) {
    .form-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .full-width {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 39.999rem) {
    form :global(.button) {
      width: 100%;
    }
  }
</style>
