---
import type { HTMLAttributes } from 'astro/types';
type Shared = { variant?: 'primary' | 'secondary'; class?: string };
type Props = Shared & (
  | (HTMLAttributes<'a'> & { href: string })
  | (HTMLAttributes<'button'> & { href?: never })
);
const { variant = 'primary', class: className, ...attributes } = Astro.props;
const buttonType = attributes.type === 'submit' || attributes.type === 'reset' ? attributes.type : 'button';
---
{ 'href' in attributes && attributes.href
  ? <a {...attributes} class:list={['button', `button--${variant}`, className]}><slot /></a>
  : <button type={buttonType} {...attributes} class:list={['button', `button--${variant}`, className]}><slot /></button>
}
