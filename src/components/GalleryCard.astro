---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { src: ImageMetadata; title: string; alt: string; eager?: boolean; }
const { src, title, alt, eager = false } = Astro.props;
---
<figure>
  <Image src={src} alt={alt} widths={[360, 640, 960]} sizes="(min-width: 64rem) 360px, (min-width: 40rem) calc((100vw - 88px) / 2), calc(100vw - 32px)" width={960} height={640} format="webp" quality={78} loading={eager ? 'eager' : 'lazy'} decoding="async" />
  <figcaption><span class="eyebrow">AI-generated demonstration</span><h2>{title}</h2><p>Imagined interior. Not a customer home or completed cleaning job.</p></figcaption>
</figure>
<style>
  figure { margin: 0; min-width: 0; border: var(--border-default); border-radius: var(--radius); background: var(--color-surface); overflow: hidden; box-shadow: var(--shadow-card); }
  img { display: block; width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: cover; }
  figcaption { padding: var(--space-5); }
  .eyebrow { font-size: .75rem; }
  h2 { font-size: 1.35rem; margin-block: var(--space-3); }
  p { margin: 0; color: var(--color-muted); font-size: var(--text-small); }
</style>
