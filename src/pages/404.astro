---
import { pageMetadata } from '../config/pageMetadata';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Button from '../components/Button.astro';
---

<BaseLayout
  title={pageMetadata.notFound.title}
  description={pageMetadata.notFound.description}
  noIndex
>
  <section class="page-intro" aria-labelledby="not-found-title">
    <SectionHeading
      level="h1"
      id="not-found-title"
      eyebrow="404 · Page not found"
      title="Let’s get you back home."
      description="The page may have moved, or the address may be incomplete."
    />
    <Button href="/">Return to homepage</Button>
    <p>
      <a href="/services/">Explore the services</a>
    </p>
  </section>
</BaseLayout>
