# Root HTTPS origin, only when the final domain is chosen.
SITE_URL=
# Keep false until instructor content, contacts and privacy practices are approved.
ALLOW_INDEXING=false
# No private keys are needed: this site has no form backend or booking integration.

# Optional. Fernanda's own public identifiers only; both blank keeps demo mode.
PUBLIC_TANGO_FORMSPREE_FORM_ID=
PUBLIC_TANGO_TURNSTILE_SITE_KEY=
# The Turnstile SECRET goes only in Fernanda's Formspree CAPTCHA settings.
