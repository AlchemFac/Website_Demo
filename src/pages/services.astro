---
import { servicesPageContent } from '../config/serviceContent';
import { pageMetadata } from '../config/pageMetadata';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Button from '../components/Button.astro';
import ServiceDetailCard from '../components/ServiceDetailCard.astro';
import PageCTA from '../components/PageCTA.astro';
import { siteContent } from '../config/siteContent';
import { services } from '../config/serviceContent';
---

<BaseLayout
  title={pageMetadata.services.title}
  description={pageMetadata.services.description}
>
  <section class="page-intro" aria-labelledby="services-title">
    <SectionHeading
      level="h1"
      id="services-title"
      eyebrow={servicesPageContent.eyebrow}
      title={servicesPageContent.title}
      description={servicesPageContent.description}
    />
    <Button href={siteContent.quoteAction.href}>
      {siteContent.quoteAction.label}
    </Button>
    <p class="demo-note">{servicesPageContent.notice}</p>
  </section>
  <nav class="service-nav" aria-label="On this page">
    <ul>
      {services.map((service) => (
        <li>
          <a href={`#${service.id}`}>
            {service.title}
            <span aria-hidden="true"> ↓</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
  <div class="service-list">
    {services.map((service) => (
      <ServiceDetailCard {...service} />
    ))}
  </div>
  <section class="section planning" aria-labelledby="planning-title">
    <SectionHeading
      id="planning-title"
      eyebrow={servicesPageContent.planningEyebrow}
      title={servicesPageContent.planningTitle}
      description={servicesPageContent.planningDescription}
    />
    <div class="card-grid">
      {servicesPageContent.planningTips.map(({ title, description }) => (
        <article class="card">
          <h3>{title}</h3>
          <p>{description}</p>
        </article>
      ))}
    </div>
  </section>
  <PageCTA
    id="services-cta"
    title={servicesPageContent.ctaTitle}
    description={servicesPageContent.ctaDescription}
  />
</BaseLayout>
<style>
  .demo-note {
    font-size: var(--text-small);
    color: var(--color-muted);
  }
  .service-nav {
    margin-bottom: var(--space-6);
  }
  .service-nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .service-nav a {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 48px;
    padding: var(--space-3) var(--space-4);
    border: var(--border-default);
    border-radius: var(--radius-pill);
    text-decoration: none;
    background: var(--color-surface);
    font-weight: var(--weight-medium);
  }
  .service-nav a:hover {
    background: var(--color-accent);
    text-decoration: underline;
  }
  .service-list {
    display: grid;
    gap: var(--space-6);
  }
  .planning {
    padding-bottom: 0;
  }
  .planning .card-grid {
    margin-top: var(--space-6);
  }
  .card h3 {
    font-size: 1.2rem;
  }
  .card p {
    color: var(--color-muted);
  }
  @media (max-width: 39.999rem) {
    .page-intro :global(.button) {
      width: 100%;
    }
    .service-nav li {
      width: 100%;
    }
    .service-nav a {
      justify-content: space-between;
    }
  }
</style>
