---
import { homeContent } from '../config/pageContent';
import { pageMetadata } from '../config/pageMetadata';
import ArrowIcon from '../components/ArrowIcon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ProcessStep from '../components/ProcessStep.astro';
import { siteContent } from '../config/siteContent';
import { business } from '../config/business';
import { services } from '../config/serviceContent';
---

<BaseLayout
  title={pageMetadata.home.title}
  description={pageMetadata.home.description}
>
  <div class="home">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">{homeContent.heroEyebrow}</p>
        <h1 id="hero-title">
          {homeContent.heroTitle}
          <br />
          <em>{homeContent.heroEmphasis}</em>
        </h1>
        <p class="hero-description">{homeContent.heroDescription}</p>
        <div class="hero-actions">
          <Button href={siteContent.quoteAction.href}>
            {siteContent.quoteAction.label} <ArrowIcon />
          </Button>
          <a class="text-link" href="#services">
            {homeContent.findServicesLabel} <span aria-hidden="true">↓</span>
          </a>
        </div>
        <p class="demo-note">{homeContent.heroNotice}</p>
      </div>
      <figure class="hero-image">
        <img
          src={homeContent.heroImageSrc}
          width={homeContent.heroImageWidth}
          height={homeContent.heroImageHeight}
          alt={homeContent.heroImageAlt}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        <figcaption>
          <span aria-hidden="true">✧</span> {homeContent.heroCaption}
          <small>{homeContent.heroImageLabel}</small>
        </figcaption>
      </figure>
    </section>

    <section
      class="home-section"
      id="services"
      aria-labelledby="services-title"
    >
      <div class="section-top">
        <SectionHeading
          id="services-title"
          eyebrow={homeContent.servicesEyebrow}
          title={homeContent.servicesTitle}
          description={homeContent.servicesDescription}
        />
        <a class="text-link" href="/services/">
          {homeContent.allServicesLabel} <ArrowIcon />
        </a>
      </div>
      <div class="services-grid">
        {services.map((service) => (
          <ServiceCard
            number={service.number}
            title={service.title}
            description={service.homepage.description}
            details={service.homepage.details}
          />
        ))}
      </div>
      <p class="scope-note">{homeContent.scopeNote}</p>
    </section>

    <section class="benefits home-section" aria-labelledby="benefits-title">
      <div class="benefits-intro">
        <SectionHeading
          id="benefits-title"
          eyebrow={homeContent.benefitsEyebrow}
          title={homeContent.benefitsTitle}
        />
        <p>{homeContent.benefitsDescription}</p>
        <a class="text-link" href={siteContent.quoteAction.href}>
          {homeContent.prioritiesLabel} <ArrowIcon />
        </a>
      </div>
      <div class="benefit-list">
        {homeContent.benefits.map(({ title, description }) => (
          <article>
            <span aria-hidden="true">✧</span>
            <div>
              <h3>{title}</h3>
              <p>{description}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="home-section process" aria-labelledby="process-title">
      <SectionHeading
        id="process-title"
        eyebrow={homeContent.processEyebrow}
        title={homeContent.processTitle}
        description={homeContent.processDescription}
      />
      <ol class="steps">
        {homeContent.steps.map((step) => (
          <ProcessStep {...step} />
        ))}
      </ol>
    </section>

    <section class="area home-section" aria-labelledby="area-title">
      <div>
        <SectionHeading
          id="area-title"
          eyebrow={homeContent.areaEyebrow}
          title={homeContent.areaTitle}
          description={homeContent.areaDescription}
        />
        <ul class="city-list" aria-label={homeContent.citiesLabel}>
          {business.serviceAreas.map((city) => (
            <li>
              <ArrowIcon /> {city}
            </li>
          ))}
        </ul>
        <a class="text-link" href={siteContent.quoteAction.href}>
          {homeContent.areaLabel} <ArrowIcon />
        </a>
      </div>
      <aside class="area-note">
        <span class="area-mark" aria-hidden="true">
          {homeContent.areaMark}
        </span>
        <h3>{homeContent.areaNoteTitle}</h3>
        <p>{homeContent.areaNoteDescription}</p>
        <p class="demo-note">{homeContent.areaNotice}</p>
      </aside>
    </section>

    <section class="final-cta" aria-labelledby="cta-title">
      <p class="eyebrow">{homeContent.ctaEyebrow}</p>
      <h2 id="cta-title">{homeContent.ctaTitle}</h2>
      <p>{homeContent.ctaDescription}</p>
      <Button href={siteContent.quoteAction.href}>
        {siteContent.quoteAction.label} <ArrowIcon />
      </Button>
      <p class="demo-note">{homeContent.ctaNotice}</p>
    </section>
    <div class="mobile-cta">
      <Button href={siteContent.quoteAction.href}>
        {siteContent.quoteAction.label} <ArrowIcon />
      </Button>
    </div>
  </div>
</BaseLayout>
<style>
  .home {
    padding-bottom: 1rem;
  }
  .hero {
    display: grid;
    gap: 2.5rem;
    align-items: center;
    padding-block: 3rem;
  }
  .hero-copy {
    min-width: 0;
  }
  h1 {
    font-family: Georgia, 'Times New Roman', serif;
    font-weight: 400;
    font-size: clamp(2.8rem, 5.2vw, 4.6rem);
    line-height: 1.06;
    letter-spacing: -0.045em;
    margin-block: 1.25rem;
  }
  h1 em {
    color: var(--color-primary);
    font-weight: 400;
  }
  .hero-description {
    font-size: 1.125rem;
    color: var(--color-muted);
    max-width: 43ch;
  }
  .hero-actions {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 2rem;
  }
  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 48px;
    font-weight: 600;
    text-decoration: none;
  }
  .text-link:hover {
    text-decoration: underline;
  }
  .demo-note,
  .scope-note {
    font-size: 0.8rem;
    color: var(--color-muted);
  }
  .hero-copy .demo-note {
    margin-top: 1rem;
  }
  .hero-image {
    position: relative;
    margin: 0;
  }
  .hero-image img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 36rem;
    object-fit: cover;
    border-radius: 8rem 8rem 1rem 1rem;
    background: var(--color-image-placeholder);
  }
  figcaption {
    position: absolute;
    bottom: 1.25rem;
    left: 1rem;
    right: 1rem;
    padding: 1rem;
    border-radius: 0.75rem;
    background: var(--color-caption-surface);
    color: var(--color-primary-hover);
    font-family: Georgia, serif;
    font-size: 1.15rem;
    box-shadow: 0 5px 20px #292e2b12;
  }
  figcaption span {
    margin-right: 0.5rem;
  }
  figcaption small {
    display: block;
    margin-top: 0.25rem;
    font:
      0.7rem system-ui,
      sans-serif;
    color: var(--color-muted);
  }
  .home-section {
    padding-block: 3.5rem;
    scroll-margin-top: 1rem;
  }
  .section-top {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2rem;
  }
  .section-top :global(.section-heading) {
    max-width: 39rem;
  }
  .section-top :global(.section-description) {
    margin-bottom: 0;
  }
  .services-grid {
    display: grid;
    gap: 1.25rem;
  }
  .scope-note {
    margin-top: 1.25rem;
  }
  .benefits {
    display: grid;
    gap: 2rem;
    border-block: 1px solid var(--color-border);
  }
  .benefits-intro > p {
    color: var(--color-muted);
  }
  .benefit-list article {
    display: flex;
    gap: 1rem;
    padding-block: 1.25rem;
  }
  .benefit-list article + article {
    border-top: 1px solid var(--color-border);
  }
  .benefit-list article > span {
    color: var(--color-primary);
    font-size: 1.8rem;
    line-height: 1.3;
  }
  .benefit-list h3 {
    margin: 0;
    font-size: 1.2rem;
  }
  .benefit-list p {
    color: var(--color-muted);
    margin-bottom: 0;
  }
  .steps {
    counter-reset: steps;
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
    display: grid;
    gap: 2rem;
  }
  .area {
    display: grid;
    gap: 2rem;
    border-top: 1px solid var(--color-border);
  }
  .city-list {
    display: flex;
    flex-wrap: wrap;
    list-style: none;
    padding: 0;
    gap: 0.75rem;
    margin-block: 1.5rem;
  }
  .city-list li {
    border: 1px solid var(--color-border);
    padding: 0.5rem 1rem;
    border-radius: 100px;
    background: var(--color-surface);
  }
  .city-list span {
    color: var(--color-primary);
  }
  .area-note {
    background: var(--color-accent);
    padding: 2rem;
    border-radius: 1rem;
    align-self: center;
  }
  .area-mark {
    font-family: Georgia, serif;
    font-size: 3rem;
    letter-spacing: -0.06em;
    color: var(--color-primary);
  }
  .area-note h3 {
    font-size: 1.3rem;
  }
  .final-cta {
    text-align: center;
    background: var(--color-accent);
    border-radius: 1.5rem;
    padding: 3rem 1.25rem;
  }
  .final-cta h2 {
    font:
      400 clamp(2rem, 4vw, 3rem)/1.15 Georgia,
      serif;
    letter-spacing: -0.035em;
  }
  .final-cta p {
    margin-inline: auto;
  }
  .final-cta :global(.button) {
    margin-block: 1rem;
  }
  .mobile-cta {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 0.75rem 1rem max(0.75rem, env(safe-area-inset-bottom));
    background: var(--color-background);
    border-top: 1px solid var(--color-border);
    z-index: 5;
  }
  .mobile-cta :global(.button) {
    width: 100%;
  }
  @media (max-width: 39.999rem) {
    :global(body:has(.home)) {
      padding-bottom: calc(5rem + env(safe-area-inset-bottom));
    }
  }
  @media (min-width: 40rem) {
    .hero {
      grid-template-columns: 1.1fr 1fr;
      gap: 2rem;
      padding-block: 4rem;
    }
    .hero-image img {
      min-height: 28rem;
    }
    .services-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .mobile-cta {
      display: none;
    }
    .home-section {
      padding-block: 4.5rem;
    }
  }
  @media (min-width: 64rem) {
    .hero {
      gap: 5rem;
    }
    .benefits {
      grid-template-columns: 1fr 1fr;
      gap: 6rem;
    }
    .area {
      grid-template-columns: 1.4fr 1fr;
      gap: 5rem;
    }
    .final-cta {
      padding: 4rem;
    }
  }
</style>
