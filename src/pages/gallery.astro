---
import { galleryContent } from '../config/gallery';
import { pageMetadata } from '../config/pageMetadata';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import GalleryCard from '../components/GalleryCard.astro';
import PageCTA from '../components/PageCTA.astro';
import { galleryImages } from '../config/gallery';
---

<BaseLayout
  title={pageMetadata.gallery.title}
  description={pageMetadata.gallery.description}
>
  <section class="page-intro" aria-labelledby="gallery-title">
    <SectionHeading
      level="h1"
      id="gallery-title"
      eyebrow={galleryContent.eyebrow}
      title={galleryContent.title}
      description={galleryContent.description}
    />
  </section>
  <div class="photo-grid">
    {galleryImages.map((image, index) => (
      <GalleryCard {...image} eager={index === 0} />
    ))}
  </div>
  <section class="gallery-note" aria-labelledby="imagery-title">
    <h2 id="imagery-title">{galleryContent.noticeTitle}</h2>
    <p>{galleryContent.notice}</p>
  </section>
  <PageCTA
    id="gallery-cta"
    title={galleryContent.ctaTitle}
    description={galleryContent.ctaDescription}
  />
</BaseLayout>
<style>
  .photo-grid {
    display: grid;
    gap: var(--space-5);
  }
  .gallery-note {
    margin-top: var(--space-7);
    padding: var(--space-6);
    background: var(--color-accent);
    border-radius: var(--radius);
  }
  .gallery-note h2 {
    margin-top: 0;
    font-size: 1.25rem;
  }
  .gallery-note p {
    margin-bottom: 0;
    color: var(--color-muted);
  }
  @media (min-width: 40rem) {
    .photo-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 64rem) {
    .photo-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
