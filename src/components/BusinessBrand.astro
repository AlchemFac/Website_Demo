---
import { business } from '../config/business';
interface Props {
  showTagline?: boolean;
}
const { showTagline = false } = Astro.props;
const { logo } = business.branding;
---

<a class="brand" href="/">
  {logo && (
    <img
      class="brand-logo"
      src={logo.src}
      width={logo.width}
      height={logo.height}
      alt=""
      decoding="async"
    />
  )}
  {business.name}
  {showTagline && (
    <span class="brand-tagline">{business.branding.tagline}</span>
  )}
</a>
<style>
  .brand-logo {
    display: block;
    width: auto;
    height: auto;
    max-width: min(10rem, 100%);
    max-height: 3rem;
    margin-bottom: var(--space-2);
  }
</style>
