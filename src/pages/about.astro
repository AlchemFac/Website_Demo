---
import { aboutContent } from '../config/pageContent';
import { pageMetadata } from '../config/pageMetadata';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Button from '../components/Button.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import PageCTA from '../components/PageCTA.astro';
import { siteContent } from '../config/siteContent';
import { business } from '../config/business';
import { philosophy } from '../config/serviceContent';
---

<BaseLayout
  title={pageMetadata.about.title}
  description={pageMetadata.about.description}
>
  <section class="page-intro" aria-labelledby="about-title">
    <SectionHeading
      level="h1"
      id="about-title"
      eyebrow={aboutContent.eyebrow}
      title={aboutContent.title}
      description={aboutContent.description}
    />
    <Button href={siteContent.quoteAction.href}>
      {siteContent.quoteAction.label}
    </Button>
    <p class="demo-note">{aboutContent.notice}</p>
  </section>
  <section class="introduction" aria-labelledby="introduction-title">
    <SectionHeading
      id="introduction-title"
      eyebrow={aboutContent.introductionEyebrow}
      title={aboutContent.introductionTitle}
    />
    <div class="introduction-copy">
      <p>{aboutContent.introduction}</p>
      <p>{aboutContent.purpose}</p>
      <a class="text-link" href="/services/">
        {aboutContent.servicesLabel} <ArrowIcon />
      </a>
    </div>
  </section>
  <section class="section philosophy" aria-labelledby="philosophy-title">
    <SectionHeading
      id="philosophy-title"
      eyebrow={aboutContent.philosophyEyebrow}
      title={aboutContent.philosophyTitle}
      description={aboutContent.philosophyDescription}
    />
    <div class="card-grid">
      {philosophy.map(({ title, description }, index) => (
        <article class="card">
          <span class="principle-number" aria-hidden="true">
            0{index + 1}
          </span>
          <h3>{title}</h3>
          <p>{description}</p>
        </article>
      ))}
    </div>
  </section>
  <section class="area panel" aria-labelledby="area-title">
    <div>
      <SectionHeading
        id="area-title"
        eyebrow={aboutContent.areaEyebrow}
        title={aboutContent.areaTitle}
        description={aboutContent.areaDescription}
      />
      <ul class="cities" aria-label={aboutContent.citiesLabel}>
        {business.serviceAreas.map((city) => (
          <li>{city}</li>
        ))}
      </ul>
    </div>
    <div class="area-copy">
      <h3>{aboutContent.areaNoteTitle}</h3>
      <p>{aboutContent.areaNoteDescription}</p>
      <a class="text-link" href={siteContent.quoteAction.href}>
        {aboutContent.areaLabel} <ArrowIcon />
      </a>
      <p class="demo-note">{aboutContent.areaNotice}</p>
    </div>
  </section>
  <PageCTA
    id="about-cta"
    title={aboutContent.ctaTitle}
    description={aboutContent.ctaDescription}
  />
</BaseLayout>
<style>
  .demo-note {
    font-size: var(--text-small);
    color: var(--color-muted);
  }
  .introduction {
    display: grid;
    gap: var(--space-5);
    border-block: var(--border-default);
    padding-block: var(--space-7);
  }
  .introduction-copy > :first-child {
    margin-top: 0;
  }
  .introduction-copy p,
  .card p,
  .area-copy p {
    color: var(--color-muted);
  }
  .text-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 48px;
    font-weight: var(--weight-medium);
  }
  .philosophy .card-grid {
    margin-top: var(--space-6);
  }
  .principle-number {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    color: var(--color-primary);
    background: var(--color-accent);
    font-weight: var(--weight-bold);
  }
  .card h3 {
    font-size: 1.25rem;
    margin-top: var(--space-5);
  }
  .area {
    display: grid;
    gap: var(--space-6);
    padding: clamp(1.5rem, 4vw, 3rem);
  }
  .cities {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding: 0;
    margin: var(--space-5) 0 0;
    list-style: none;
  }
  .cities li {
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-pill);
    background: var(--color-accent);
  }
  .area-copy {
    align-self: center;
  }
  .area-copy h3 {
    font-size: 1.3rem;
    margin-top: 0;
  }
  @media (min-width: 48rem) {
    .introduction,
    .area {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-8);
    }
  }
  @media (max-width: 39.999rem) {
    .page-intro :global(.button) {
      width: 100%;
    }
  }
</style>
