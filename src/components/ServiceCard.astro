---
import { serviceLabels } from '../config/serviceContent';
import ArrowIcon from './ArrowIcon.astro';
interface Props {
  number: string;
  title: string;
  description: string;
  details: string;
}
const { number, title, description, details } = Astro.props;
---

<article class="service-card">
  <span class="service-number" aria-hidden="true">
    {number}
  </span>
  <h3>{title}</h3>
  <p>{description}</p>
  <p class="service-details">{details}</p>
  <a
    href="/services/"
    aria-label={`${serviceLabels.exploreAccessiblePrefix} ${title}`}
  >
    {serviceLabels.explore} <ArrowIcon />
  </a>
</article>
<style>
  .service-card {
    display: flex;
    flex-direction: column;
    padding: clamp(1.5rem, 3vw, 2rem);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 1rem;
  }
  .service-number {
    width: 2.75rem;
    height: 2.75rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--color-accent);
    color: var(--color-primary);
    font-size: 0.85rem;
    font-weight: 700;
  }
  h3 {
    font-size: 1.45rem;
    margin: 1.5rem 0 0.5rem;
  }
  p {
    color: var(--color-muted);
    margin: 0.5rem 0;
  }
  .service-details {
    font-size: 0.875rem;
    border-top: 1px solid var(--color-border);
    padding-top: 1rem;
    margin-top: 1rem;
  }
  a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 48px;
    margin-top: auto;
    padding-top: 1rem;
    font-weight: 600;
    text-decoration: none;
  }
  a:hover {
    text-decoration: underline;
  }
</style>
