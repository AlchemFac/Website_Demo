---
import { business } from '../config/business';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/global.css';
import { indexingAllowed } from '../config/seo.mjs';
interface Props {
  title: string;
  description?: string;
  noIndex?: boolean;
}
const {
  title,
  description = business.description,
  noIndex = false,
} = Astro.props;
const indexable =
  !noIndex &&
  indexingAllowed(Astro.site, import.meta.env.ALLOW_INDEXING, business.isDemo);
const canonical =
  !noIndex && Astro.site
    ? new URL(Astro.url.pathname, Astro.site).href
    : undefined;
const { colors } = business.branding;
const themeStyle = [
  `--color-primary: ${colors.primary}`,
  `--color-primary-hover: ${colors.primaryHover}`,
  `--color-background: ${colors.background}`,
  `--color-text: ${colors.text}`,
  `--color-accent: ${colors.accent}`,
  `--color-surface: ${colors.surface}`,
  `--color-muted: ${colors.muted}`,
  `--color-border: ${colors.border}`,
  `--color-on-primary: ${colors.onPrimary}`,
  `--color-caption-surface: ${colors.captionSurface}`,
  `--color-image-placeholder: ${colors.imagePlaceholder}`,
].join(';');
---

<!doctype html>
<html lang="en" style={themeStyle}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={indexable ? 'index, follow' : 'noindex, nofollow'}
    />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta
      property="og:title"
      content={`${title} | ${business.name}${business.isDemo ? ' — Demo' : ''}`}
    />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <title>{title} | {business.name}{business.isDemo ? ' — Demo' : ''}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      Skip to content
    </a>
    <SiteHeader />
    <main id="main-content" class="container" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
