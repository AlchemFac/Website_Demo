---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
---
<BaseLayout title="Services">
  <section class="page-intro">
    <SectionHeading level="h1" eyebrow="Demo · Placeholder" title="Services" description="Use this page to describe the business’s services, scope, and scheduling details." />
  </section>
  <div class="card-grid">
    {['Routine cleaning', 'Deep cleaning', 'Move-in / move-out cleaning'].map((title) => (
      <section class="panel"><h2>{title}</h2><p>Sample category only. Add verified service details here before launch.</p></section>
    ))}
  </div>
</BaseLayout>
