---
import { contactContent } from '../config/contactContent';
import { pageMetadata } from '../config/pageMetadata';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ContactForm from '../components/ContactForm.astro';
import { contactForm } from '../config/contactForm';
import { business } from '../config/business';
---

<BaseLayout
  title={pageMetadata.contact.title}
  description={pageMetadata.contact.description}
>
  <section class="page-intro" aria-labelledby="contact-title">
    <SectionHeading
      level="h1"
      id="contact-title"
      eyebrow={contactContent.eyebrow}
      title={contactContent.title}
      description={
        contactForm.configured
          ? contactContent.configuredDescription
          : contactContent.offlineDescription
      }
    />
  </section>
  <div class="contact-layout">
    <aside class="contact-info" aria-label={contactContent.informationLabel}>
      <section class="panel" aria-labelledby="details-title">
        <h2 id="details-title">{contactContent.detailsTitle}</h2>
        <p>{business.name}</p>
        <dl>
          <dt>Phone</dt>
          <dd>{business.phone.display}</dd>
          <dt>Email</dt>
          <dd>{business.email}</dd>
        </dl>
        <p class="note">{contactContent.detailsNotice}</p>
      </section>
      <section class="panel" aria-labelledby="hours-title">
        <h2 id="hours-title">{contactContent.hoursTitle}</h2>
        <dl>
          {business.hours.map(({ days, hours }) => (
            <div>
              <dt>{days}</dt>
              <dd>{hours}</dd>
            </div>
          ))}
        </dl>
      </section>
      <section class="panel" aria-labelledby="areas-title">
        <h2 id="areas-title">{contactContent.areasTitle}</h2>
        <ul>
          {business.serviceAreas.map((area) => (
            <li>{area}</li>
          ))}
        </ul>
        <p class="note">{contactContent.areasNotice}</p>
      </section>
    </aside>
    <ContactForm />
  </div>
</BaseLayout>
<style>
  .contact-layout {
    display: grid;
    gap: var(--space-6);
    align-items: start;
  }
  .contact-info {
    display: grid;
    gap: var(--space-5);
    min-width: 0;
  }
  .contact-info h2 {
    font-size: 1.25rem;
  }
  .note {
    color: var(--color-muted);
    font-size: var(--text-small);
  }
  ul {
    padding-left: 1.25rem;
  }
  @media (min-width: 64rem) {
    .contact-layout {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.6fr);
    }
  }
</style>
